{
	"folders": [
		{
			"name": "Python",
			"path": ".."
		},
		{
			"name": "Workspace Settings",
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			".vscode": true
		},
		"[python]": {
			"editor.formatOnSaveMode": "file",
			"editor.formatOnSave": true,
			"editor.defaultFormatter": "eeyore.yapf",
			"editor.formatOnType": false
		},
		"yapf.args": [
			"--style",
			"./.style.yapf"
		],
		"python.analysis.typeCheckingMode": "standard"
	}
}